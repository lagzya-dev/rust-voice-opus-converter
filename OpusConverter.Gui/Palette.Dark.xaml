<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Same token names as Palette.Light.xaml - only one of the two is ever merged into App.xaml's resources
         (see ThemeManager), and every style in Theme.xaml reads these through DynamicResource so swapping which
         one is merged re-themes the whole app live. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6366F1"/>
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#818CF8"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#A5B4FC"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#25243D"/>
    <SolidColorBrush x:Key="WindowBrush" Color="#121317"/>
    <SolidColorBrush x:Key="CardBrush" Color="#1B1D23"/>
    <SolidColorBrush x:Key="LineBrush" Color="#2B2E36"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#3B3F4A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E7E9ED"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#9AA1AC"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#24262D"/>
    <SolidColorBrush x:Key="PressedBrush" Color="#2C2F37"/>
    <SolidColorBrush x:Key="OkBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="WarnTextBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarnBackBrush" Color="#2A2110"/>
    <SolidColorBrush x:Key="WarnLineBrush" Color="#92700A"/>

</ResourceDictionary>
